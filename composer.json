{
    "name": "goodport/mail-tracker",
    "description": "Log and track outgoing Laravel emails with per-type retention and a built-in admin panel.",
    "type": "library",
    "homepage": "https://github.com/goodport/mail-tracker",
    "license": "MIT",
    "authors": [
        {
            "name": "Goodport"
        },
        {
            "name": "J David Baker",
            "email": "me@jdavidbaker.com",
            "role": "Original author"
        }
    ],
    "keywords": [
        "email",
        "email-tracking",
        "laravel",
        "mail",
        "retention",
        "tracking"
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.2|^8.0",
        "aws/aws-php-sns-message-validator": "^1.8",
        "aws/aws-sdk-php": "^3.372"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "phpunit/phpunit": "^9.5.10|^10.5|^11.5.3|^12.5.12",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "mockery/mockery": "^1.4.4"
    },
    "suggest": {
        "fedeisas/laravel-mail-css-inliner": "Automatically inlines CSS into all outgoing mail."
    },
    "autoload": {
        "psr-4": {
            "jdavidbakr\\MailTracker\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "jdavidbakr\\MailTracker\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "jdavidbakr\\MailTracker\\MailTrackerServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev"
}
